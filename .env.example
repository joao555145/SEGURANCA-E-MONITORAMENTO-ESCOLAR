# Telemetria do ESP -> JazzSecurity (não é a API da UmbrellA).
VITE_API_BASE_URL=http://localhost:3001

# Chat UmbrellA -> Adan-Stella. Localmente use o perfil HTTP:
# dotnet run --launch-profile http  (0.0.0.0:5171)
VITE_UMBRELLA_API_BASE_URL=http://localhost:5171

# Em outro dispositivo da mesma rede, use http://IP-DO-PC:5171.
# Em produção, use a origem HTTPS pública do Adan-Stella e autorize a origem
# do School Safe em Cors:AllowedOrigins no Adan-Stella.
